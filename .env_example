DATABASE_URL="postgres://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_HOST:POSTGRES_PORT/POSTGRES_DB"

# better-auth configuration
BETTER_AUTH_SECRET=  # Min 32 chars, generate with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000  # App base URL

# Authentik OAuth (optional - enables "Mit Authentik anmelden" button)
# Configure in Authentik: Redirect URI = {BETTER_AUTH_URL}/api/auth/oauth2/callback/authentik
AUTHENTIK_URL=  # e.g., https://auth.example.com
AUTHENTIK_APP_SLUG=  # Application slug in Authentik (default: msb-inventory)
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# Kanidm OIDC (optional - enables "Mit Kanidm anmelden" button)
# Configure in Kanidm: Redirect URI = {BETTER_AUTH_URL}/api/auth/oauth2/callback/kanidm
# Kanidm requires PKCE (enabled in code) and returns real, verified emails.
KANIDM_URL=  # e.g., https://idm.example.com
KANIDM_CLIENT_ID=  # OAuth2 client name (used in discovery URL path)
KANIDM_CLIENT_SECRET=  # from: kanidm system oauth2 show-basic-secret <client>
KANIDM_ADMIN_GROUP=zeug-admin  # Kanidm group whose members get the app "admin" role
# Requires a Kanidm claim-map that emits this group name in a `groups` claim:
#   kanidm system oauth2 update-claim-map-join <client> groups array
#   kanidm system oauth2 update-claim-map <client> groups zeug-admin zeug-admin

SAVE_PATH=

GEMINI_API_KEY=

BASE_URL=https://example.com

# MQTT Configuration for Label Printer
MQTT_BROKER_URL=mqtts://mqtt.example.com:8883
MQTT_USERNAME=
MQTT_PASSWORD=
