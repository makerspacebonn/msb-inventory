{
  "name": "msb-inventory",
  "version": "0.2.7",
  "description": "Inventarsystem für den Makerspace Bonn",
  "author": {
    "name": "Falk Kühnel",
    "email": "falk@kuehnel.eu",
    "url": "https://kuehnel.eu"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "docker compose up postgres -d && bun --hot --bun vite dev --port 3000 --host 0.0.0.0",
    "dev:bg": "pkill -f 'bun.*vite.*dev' 2>/dev/null || true; mkdir -p logs && nohup bun run dev > logs/dev.log 2>&1 & echo \"Dev server started (PID: $!) - logs at logs/dev.log\"",
    "dev:logs": "tail -f logs/dev.log",
    "build": "bun --bun vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:tests": "docker compose exec app bun --watch --dots test",
    "dev:stop": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "test:e2e": "bash scripts/e2e-test.sh",
    "test:e2e:headed": "bash scripts/e2e-test.sh --headed",
    "test:e2e:debug": "bash scripts/e2e-test.sh --debug",
    "test:e2e:ui": "bun playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:report": "bun playwright show-report e2e/playwright-report",
    "test:e2e:seed": "bun run scripts/seed-e2e-data.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "ansis": "^4.5.0",
    "better-auth": "^1.7.18",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eta": "^4.6.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.69.0",
    "mqtt": "^5.16.1",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.3",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "qs": "^6.16.1",
    "cookie": "^1.1.1",
    "hono": "^4.13.14",
    "undici": "^7.30.1",
    "diff": "^8.0.3",
    "ws": "^8.21.0",
    "defu": "^6.1.5",
    "ip-address": "^10.7.4",
    "proxy-addr": "^2.0.8",
    "seroval": "^1.6.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "^1.64.1",
    "@tanstack/devtools-vite": "^0.8.6",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/ui": "5.1.0",
    "bun-plugin-tailwind": "^0.1.2",
    "bun-types": "^1.4.4",
    "happy-dom": "^21.0.4",
    "jimp": "^1.6.1",
    "shadcn": "^4.23.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.1.0"
  },
  "module": "src/index.js"
}
