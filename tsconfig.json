{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "paths": {
      "@server/*": ["./src/*"],
      "@public/*": ["./public/*"],
      "@/*": ["./*"],
      "@components/*": ["./components/*"]
    },
    "types": ["bun-types"]
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/experiment*",
    "container",
    "usr",
    "e2e/playwright-report",
    "e2e/test-results"
  ]
}
